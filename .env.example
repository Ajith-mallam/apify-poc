# Copy this file to .env and fill in real values. Never commit .env.

# Apify API token (Apify Console -> Settings -> API & Integrations).
# Secret: never paste it into code, logs, output files or the browser.
APIFY_TOKEN=apify_api_replace_me

# Optional, recommended when deployed: visitors must enter this code (min 6
# characters) before they can run a collection. Leave empty to disable.
DEMO_ACCESS_CODE=

# Optional. Comma-separated example pages shown as one-click suggestions in
# the UI. This is NOT a restriction: any public Facebook page URL can be
# entered. (The old name AUTHORIZED_PAGES is still accepted.)
EXAMPLE_PAGES=https://www.facebook.com/examplepage,anotherpage

# Optional. Page prefilled in the UI (any valid Facebook page URL).
DEFAULT_PAGE_URL=https://www.facebook.com/examplepage

# Optional. Upper limit on posts per run. Leave empty (or 0) for no limit.
# Either way, every run is given an Apify cost cap that matches the number
# of posts requested ($0.001 per run + $0.005 per post on the free plan).
MAX_POSTS=

# Local only: port for `npm run ui` (bound to 127.0.0.1). Not used on Vercel.
UI_PORT=4321
